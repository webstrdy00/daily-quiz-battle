{
  "name": "daily-quiz-battle",
  "version": "0.1.0",
  "private": true,
  "description": "Apps in Toss daily quiz battle",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev:web": "pnpm --filter @daily-quiz-battle/web dev",
    "dev:admin": "pnpm --filter @daily-quiz-battle/admin dev",
    "dev:api": "pnpm --filter @daily-quiz-battle/api dev",
    "build": "pnpm --filter @daily-quiz-battle/contracts build && pnpm --filter @daily-quiz-battle/api build && pnpm --filter @daily-quiz-battle/web build && pnpm --filter @daily-quiz-battle/admin build",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm --filter @daily-quiz-battle/contracts build && pnpm -r --if-present typecheck",
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "test": "pnpm --filter @daily-quiz-battle/api test",
    "test:integration": "pnpm --filter @daily-quiz-battle/api test",
    "db:migrate": "pnpm --filter @daily-quiz-battle/api db:migrate",
    "db:seed": "pnpm --filter @daily-quiz-battle/api db:seed"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
