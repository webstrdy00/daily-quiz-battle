{
  "name": "@daily-quiz-battle/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "oxlint src drizzle.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @daily-quiz-battle/contracts build && node --env-file-if-exists=../../.env --import tsx --test --test-concurrency=1 src/integration/daily.integration.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@daily-quiz-battle/contracts": "workspace:*",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "drizzle-orm": "0.45.2",
    "fastify": "5.12.1",
    "jose": "6.2.10",
    "postgres": "3.4.9",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "drizzle-kit": "0.31.10",
    "oxlint": "1.80.0",
    "tsx": "4.23.12",
    "typescript": "6.0.2"
  }
}
