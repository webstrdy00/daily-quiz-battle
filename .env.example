# Runtime
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgres://daily_quiz:daily_quiz_local@localhost:5432/daily_quiz
# Integration tests only; must target a maintenance DB, never the app DB.
TEST_DATABASE_ADMIN_URL=postgres://daily_quiz:daily_quiz_local@localhost:5432/postgres

# Identity: mock is allowed only when APP_ENV=development
IDENTITY_VERIFICATION_MODE=mock
IDENTITY_VERIFY_URL=https://apps-in-toss-api.toss.im/api-partner/v1/apps-in-toss/users/anon-key/verify
IDENTITY_MTLS_CERT=
IDENTITY_MTLS_KEY=
IDENTITY_MTLS_CA=
ANON_KEY_PEPPER=local-only-anon-key-pepper-change-before-production-2026

# Internal access token
ACCESS_TOKEN_SECRET=local-only-access-token-secret-change-before-production-2026
ACCESS_TOKEN_TTL_SECONDS=1800
ACCESS_TOKEN_ISSUER=daily-quiz-battle-api
ACCESS_TOKEN_AUDIENCE=daily-quiz-battle-web

# Server-only admin access token verification
ADMIN_ACCESS_TOKEN_SECRET=local-only-admin-access-token-secret-change-before-production-2026
ADMIN_ACCESS_TOKEN_ISSUER=daily-quiz-battle-admin
ADMIN_ACCESS_TOKEN_AUDIENCE=daily-quiz-battle-content-api

# Challenge share token derivation (ADR-0003). Rotate by moving the current
# value to *_PREVIOUS for 48h so open challenges keep replaying.
CHALLENGE_TOKEN_SECRET=local-only-challenge-token-secret-change-before-production-2026
CHALLENGE_TOKEN_SECRET_PREVIOUS=

# Server-only result notification delivery. Replace the local key and provide
# the Apps in Toss template set code outside development. During rotation, set
# both previous fields only until all stored targets have been re-encrypted.
NOTIFICATION_TARGET_ENCRYPTION_KEY=bG9jYWwtbm90aWZpY2F0aW9uLWtleS0zMi1ieXRlcyE=
NOTIFICATION_TARGET_ENCRYPTION_KEY_VERSION=1
NOTIFICATION_TARGET_ENCRYPTION_KEY_PREVIOUS=
NOTIFICATION_TARGET_ENCRYPTION_KEY_VERSION_PREVIOUS=
RESULT_NOTIFICATION_TEMPLATE_SET_CODE=
NOTIFICATION_SEND_URL=https://apps-in-toss-api.toss.im/api-partner/v1/apps-in-toss/messenger/send-message

# In-memory rate limit; set false only for local load probes. Forced true in production.
RATE_LIMIT_ENABLED=true

# Exact allowed origins, comma separated
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public Web configuration (included in the browser bundle)
VITE_API_BASE_URL=http://127.0.0.1:3000
VITE_APP_ENV=development
VITE_DEV_ANONYMOUS_KEY=dev-local-player-001
VITE_RESULT_NOTIFICATION_TEMPLATE_CODE=dev-result-notification-template
